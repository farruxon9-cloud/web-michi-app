# ===================================================
# MICHI APP — ENVIRONMENT VARIABLES EXAMPLE
# DO NOT PUSH ACTUAL SECRETS TO GITHUB
# ===================================================

# Google Gemini API (Asosiy AI motor)
# Olish: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_key_here

# Zaxira kalitlar (yuklamani taqsimlash uchun)
VITE_GEMINI_API_KEY_2=
VITE_GEMINI_API_KEY_3=
VITE_GEMINI_API_KEY_4=
VITE_GEMINI_API_KEY_5=

# Hugging Face (AI Brain endpoint)
# Olish: https://huggingface.co/settings/tokens
VITE_HF_BRAIN_URL=https://farruxkanoatov-michiai.hf.space/api/predict

# ElevenLabs (Ovozli javob — ixtiyoriy)
VITE_ELEVENLABS_API_KEY=

# n8n Webhook va Header Auth (Email OTP xavfsizlik)
VITE_N8N_OTP_WEBHOOK_URL=http://your-n8n-server:5678/webhook/your-webhook-id
VITE_N8N_API_KEY=your_secret_n8n_api_key_here

# Ilova muhiti va versiyasi
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
