{
  "name": "Michi Auth Monitoring & Bot Protection Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "auth/failed-attempt",
        "options": {}
      },
      "name": "Webhook: /auth/failed-attempt",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO auth_attempts (email, ip_address, device_id, success, attempted_at) VALUES ($1, $2, $3, false, NOW()) RETURNING *;"
      },
      "name": "Supabase: Record Attempt",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [320, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.attemptsCount }}",
              "operation": "largerEqual",
              "value2": 10
            }
          ]
        }
      },
      "name": "IF: 10+ Failed Attempts",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [540, 300]
    },
    {
      "parameters": {
        "fromEmail": "security@michi-app.com",
        "toEmail": "admin@michi-app.com",
        "subject": "🚨 [Michi Security Alert] Suspicious Login Activity Detected",
        "text": "Suspicious login attempts detected for IP/Email."
      },
      "name": "Email: Alert Admin",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [760, 200]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.attemptsCount }}",
              "operation": "largerEqual",
              "value2": 30
            }
          ]
        }
      },
      "name": "IF: 30+ Failed Attempts (Bot Attack)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [760, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO blocked_ips (ip_address, blocked_until, reason) VALUES ($1, NOW() + INTERVAL '24 hours', 'Automated Bot Attack') ON CONFLICT DO NOTHING;"
      },
      "name": "Supabase: Add IP to Blocklist",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [980, 400]
    }
  ],
  "connections": {
    "Webhook: /auth/failed-attempt": {
      "main": [
        [
          {
            "node": "Supabase: Record Attempt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase: Record Attempt": {
      "main": [
        [
          {
            "node": "IF: 10+ Failed Attempts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF: 10+ Failed Attempts": {
      "main": [
        [
          {
            "node": "Email: Alert Admin",
            "type": "main",
            "index": 0
          },
          {
            "node": "IF: 30+ Failed Attempts (Bot Attack)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF: 30+ Failed Attempts (Bot Attack)": {
      "main": [
        [
          {
            "node": "Supabase: Add IP to Blocklist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
