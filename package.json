{
  "name": "michi-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:admin": "vite --config vite.admin.config.js",
    "build:admin": "vite build --config vite.admin.config.js",
    "build:mobile": "vite build && npx cap sync",
    "lint": "eslint src",
    "preview": "vite preview",
    "find": "node scripts/fast_lookup.mjs",
    "impact": "node scripts/analyze_impact.mjs",
    "test": "vitest run",
    "verify": "npm run lint && npm run test && npm run build",
    "validate": "node scripts/generate_codebase_map.js && npm run lint && npm run test && node tests/e2e.js && npm run build",
    "check": "node scripts/check.mjs",
    "check:fast": "node scripts/check.mjs --fast",
    "map": "node scripts/gen_page_map.mjs",
    "graph": "graphify update .",
    "sync:web-start": "node scripts/sync_web_start.mjs",
    "hooks": "node scripts/install_hooks.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.3",
    "compromise": "^14.17.0",
    "i18next": "^26.4.2",
    "leaflet": "^1.9.4",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.49.0",
    "maplibre-gl": "^6.10.0",
    "pdfmake": "^0.3.11",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-map-gl": "^8.1.3",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "terser": "^5.51.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
